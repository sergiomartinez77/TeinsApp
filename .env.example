# TEINS App — Variables de entorno
# Copia este archivo como `.env` y completa los valores reales.
# `.env` está en .gitignore: nunca lo subas al repositorio.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública "anon" (NUNCA la service_role key).
SUPABASE_ANON_KEY=
POWERSYNC_URL=https://TU-INSTANCIA.powersync.journeyapps.com
# development | staging | production
APP_ENV=development
# debug | info | warning | error | none  (por defecto: debug; en producción: info)
LOG_LEVEL=debug
# Id del proyecto de EAS (lo genera `eas init`; no es secreto). Opcional en local.
# EAS_PROJECT_ID=
