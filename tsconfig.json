{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Los módulos de supabase/functions (Deno) importan con extensión ".ts".
    "allowImportingTsExtensions": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Al definir "exclude" se reemplaza el de expo/tsconfig.base: se repiten sus
  // entradas. Las funciones Edge (index.ts) usan Deno y especificadores npm:,
  // que este tsc no resuelve; su lógica está en módulos puros que sí se compilan.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions/*/index.ts"
  ]
}
