{
  "name": "teins-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.5",
    "@op-engineering/op-sqlite": "^15.2.14",
    "@powersync/op-sqlite": "^0.9.17",
    "@powersync/react": "^1.10.0",
    "@powersync/react-native": "^1.35.11",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.13.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,js,json}\" \"docs/**/*.md\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "backend:validate": "node supabase/tests/validate.mjs",
    "backend:check": "node scripts/check-backend.mjs",
    "prebuild:check": "expo config --type public && npx expo-doctor",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:ios-simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "build:prod:android": "npx eas-cli@latest build --profile production --platform android",
    "build:prod:ios": "npx eas-cli@latest build --profile production --platform ios"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  }
}
